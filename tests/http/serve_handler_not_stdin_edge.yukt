use std/http
use std/net
use std/io
use std/map

create handle(req):
    r = io.read_line()
    if r.ok:
        n = r.value
    give http.Response(200, map.new(), "ok")

create run(ln):
    http.serve_on(ln, handle)

create main:
    bound = net.listen("127.0.0.1:0")
    if bound.ok:
        t = start run(bound.value)
        wait t
