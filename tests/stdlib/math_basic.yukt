use std/math

create main:
    say math.abs_i(-3)
    say math.abs_i(4)
    say math.abs_f(-2.5)
    say math.min_i(3, -1)
    say math.max_i(3, -1)
    say math.min_f(3.0, -1.5)
    say math.max_f(3.0, -1.5)
    say math.floor(2.3)
    say math.floor(-2.3)
    say math.ceil(2.3)
    say math.ceil(-2.3)
    say math.sqrt(4.0)
    say math.pow(2.0, 3.0)
    say math.sin(0.0)
    say math.cos(0.0)
    say math.tan(0.0)
    say math.exp(0.0)
    say math.log(1.0)
    nanv = math.sqrt(-1.0)
    say nanv == nanv
    mixed = math.min_f(1.0, nanv)
    say mixed == mixed
    high = math.max_f(1.0, nanv)
    say high == high
    infv = math.log(0.0)
    say infv == infv
    say math.abs_f(infv) == math.abs_f(infv)
