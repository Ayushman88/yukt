use std/str

create main:
    say str.len("")
    say str.len("abc")
    say str.at("abc", 0)
    say str.at("abc", 2)
    say str.slice("abcdef", 2, 5)
    say str.slice("abc", 1, 1)
    say str.slice("hi", 0, str.len("hi"))
    say str.find("hello", "ll")
    say str.find("hello", "z")
    say str.find("hello", "")
    say str.contains("hello", "ell")
    say str.contains("hello", "x")
    say str.starts("hello", "he")
    say str.starts("hello", "")
    say str.starts("hello", "lo")
    say str.ends("hello", "lo")
    say str.ends("hello", "")
    say str.ends("hello", "he")
    say str.repeat("ab", 3)
    say str.repeat("ab", 0)
    say str.repeat("", 5)
    say str.join([], ",")
    say str.join(["only"], ",")
    say str.join(["a", "b", "c"], ",")
    say str.join(["a", "b"], "")
    parts = str.split("a,b,c", ",")
    say parts
    say str.len(parts[0])
    say str.len(parts[1])
    say str.len(parts[2])
    trailing = str.split("a,b,", ",")
    say trailing
    leading = str.split(",a", ",")
    say leading
    adjacent = str.split("a,,b", ",")
    say adjacent
    empty = str.split("", ",")
    say count(empty)
    say str.len(empty[0])
    say str.at("café", 0)
    say str.at("café", 1)
    say str.at("café", 2)
    say str.at("café", 3)
    say str.at("café", 4)
