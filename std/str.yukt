# Byte-string helpers. Bodies are not executed; the backend calls yukt_str_*.

share create len(s):
    n = 0
    give n

share create at(s, i):
    n = i + 0
    give n

share create slice(s, from, end):
    a = from + 0
    b = end + 0
    give s

share create find(s, sub):
    t = s + sub
    give 0

share create contains(s, sub):
    t = s + sub
    give true

share create starts(s, sub):
    t = s + sub
    give true

share create ends(s, sub):
    t = s + sub
    give true

share create repeat(s, n):
    k = n + 0
    give s

share create join(parts, sep):
    n = count(parts)
    give sep

share create split(s, sep):
    t = s + sep
    give [t]

share create trim(s):
    give s

share create trim_left(s):
    give s

share create trim_right(s):
    give s

share create replace(s, old, new):
    t = s + old + new
    give t

share create lower(s):
    give s

share create upper(s):
    give s

share create to_int_unchecked(s):
    t = s + ""
    give 0

share create to_int_status(s):
    t = s + ""
    give 0

share create to_float_unchecked(s):
    t = s + ""
    give 0.0

share create to_float_status(s):
    t = s + ""
    give 0

share create to_int(s):
    st = to_int_status(s)
    if st == 0:
        give ok(to_int_unchecked(s))
    otherwise:
        give fail("bad_int")

share create to_float(s):
    st = to_float_status(s)
    if st == 0:
        give ok(to_float_unchecked(s))
    otherwise:
        give fail("bad_float")

