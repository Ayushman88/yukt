# Process environment. Empty names fail in get and trap in has / set / get_or.

share create get_unchecked(name):
    t = name + ""
    give t

share create has(name):
    t = name + ""
    give true

share create set(name, value):
    t = name + value

share create get(name):
    if name == "":
        give fail("io")
    otherwise:
        if has(name):
            give ok(get_unchecked(name))
        otherwise:
            give fail("not_found")

share create get_or(name, fallback):
    if has(name):
        give get_unchecked(name)
    otherwise:
        give fallback
