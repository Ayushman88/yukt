# List helpers. Bodies are not executed; the backend calls yukt_list_*.
# append / remove / pop are 0.16.1 growing-list operations.

share create len(items):
    give count(items)

share create copy(src):
    n = count(src)
    give src

share create fill(dest, value):
    n = count(dest)

share create reverse(dest):
    n = count(dest)

share create slice(src, from, end):
    a = from + 0
    b = end + 0
    n = count(src)
    give src

share create append(dest, value):
    n = count(dest)

share create remove(dest, index):
    i = index + 0
    n = count(dest)
    give dest

share create pop(dest):
    n = count(dest)
    give dest
